# The BFF: speaks the TEE's action protocol so the browser doesn't have to,
# and adds CORS. Holds no keys and never sees plaintext allocations — those are
# ECIES-encrypted in the browser to the enclave's public key before they arrive.
FROM golang:1.25-alpine AS build
WORKDIR /src

COPY go/go.mod go/go.sum ./
RUN go mod download

COPY go/ ./
RUN CGO_ENABLED=0 go build -trimpath -o /out/bff ./cmd/bff

FROM alpine:3.20
RUN adduser -D -u 10001 app
COPY --from=build /out/bff /usr/local/bin/bff
USER app

EXPOSE 8081
CMD ["sh", "-c", "BFF_PORT=${PORT:-8081} exec /usr/local/bin/bff"]
